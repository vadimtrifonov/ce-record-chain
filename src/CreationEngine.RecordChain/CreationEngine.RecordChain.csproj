<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)..\..\packages.lock.json</NuGetLockFilePath>
    <UseAppHost>true</UseAppHost>
    <CetCompat>false</CetCompat>
    <AssemblyName>ce-record-chain</AssemblyName>
    <RootNamespace>CreationEngine.RecordChain</RootNamespace>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CreationEngine.RecordChain.Tests" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="Mutagen.Bethesda.Starfield" Version="0.54.4" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
